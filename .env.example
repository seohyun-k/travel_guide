# 브라우저용 Google Maps JavaScript API 키 (HTTP 리퍼러 제한 필수)
# 허용 API: Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 선택: 클라우드 기반 지도 스타일의 Map ID (없으면 DEMO_MAP_ID 사용)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# 서버 전용 키 (절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요)
# 허용 API: Places API (New), Routes API
GOOGLE_MAPS_SERVER_KEY=
